# Python
.venv/
__pycache__/
*.pyc
*.egg-info/

# Data: the token shards are 4.1 GB and are regenerated by `make bins`.
# NOTE: `data/*.bin` is NOT enough -- `*` does not cross `/`, so it silently
# missed data/proc/*.bin and a `git add -A` started copying 4 GB into .git.
data/proc/*
!data/proc/manifest.json
!data/proc/.gitkeep
data/raw/
data/*.bin
data/*.npy

# Run artifacts
ckpts/
logs/*.csv
!logs/.gitkeep
!logs/*.out
results/*.png
results/overlap.json

# Transport bundles (tar of data/proc)
*.tar
*.tar.gz
*.tgz

# OS / editor
.DS_Store
.ipynb_checkpoints/
